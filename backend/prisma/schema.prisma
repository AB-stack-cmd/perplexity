// ─── Prisma Config ────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Provider {
  Google
  Github
}

enum Role {
  User
  Assistant
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id          String         @id @default(cuid())
  supabaseId  String         @unique           // used by middleware upsert + lookup
  email       String
  name        String
  provider    Provider

  conversations Conversation[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([supabaseId])                        // middleware queries this on every request
  @@map("users")
}

model Conversation {
  id        String    @id @default(cuid())
  title     String
  slug      String    @unique
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  messages  Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])                            // GET /conversation filters by userId
  @@index([userId, createdAt(sort: Desc)])     // ordered list query
  @@map("conversations")
}

model Message {
  id      String  @id @default(cuid())
  content String  @db.Text                     // answers can be very long
  role    Role

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  createdAt DateTime @default(now())

  @@index([conversationId])                    // messages are always fetched by conversation
  @@map("messages")
}
